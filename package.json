    "@types/react": "~19.2.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "// exclude": "OCR (SPEC.md §5.15 mode T3). Legacy bridge module, no New Arch metadata; runs through the interop layer and utils/recipeOcr.ts gates on the native module being present, so the worst case is a hidden menu entry. See docs/upgrade-sdk-57.md risk R1.",
