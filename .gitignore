# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# native builds — root-level prebuild output only; anchored so the pattern
# does NOT swallow local expo modules' native code (modules/*/android)
/ios/
/android/
# gradle build output inside local expo modules
modules/*/android/build/
*.ipa
*.apk
*.aab

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# credentials and signing material — never tracked
# (eas.json submit.serviceAccountKeyPath points here)
google-play-service-account.json
*service-account*.json
credentials*.json
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# TypeScript
*.tsbuildinfo

# agent/E2E test artifacts
.playwright-mcp/

# Build artifacts (regenerable, not source — see scripts/README.md)
# local EAS APK output (eas build --local)
keeptaste.apk
# transient EAS build log
eas-build.log
# generated demo backups — rebuild with scripts/build-demo-backup.ts [pl]
assets/store/keeptaste-demo.zip
assets/store/keeptaste-demo-pl.zip
# cropped demo photos — rebuild with scripts/crop-demo-photos.sh
assets/store/crops/
# rendered Play Store frames — rebuild with scripts/build-store-screenshots.ts
# from the raw captures in assets/app/ (those are source and stay tracked)
assets/store/play/
# promo video: the screen takes, the rendered mp4s and the music track. Unlike
# the still screenshots, the raw takes are ignored too — they are tens of MB of
# video and re-shooting them is one scripted command
# (scripts/record-promo-clips.sh). The storyboard copy is the source and lives
# in assets/store/promo-script.json.
assets/store/promo/

# persona-lab session output (screenshots, videos, transcripts)
/persona-lab/runs/

# e2e test runs (reports, traces, videos, replay cache, Metro log)
/.e2e/

# jest --coverage output
/coverage/
