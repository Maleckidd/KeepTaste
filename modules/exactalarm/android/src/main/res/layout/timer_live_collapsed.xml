<?xml version="1.0" encoding="utf-8"?>
<!--
  Live countdown notification, collapsed (SPEC.md §5.21 stage 3). Android 12+
  caps a decorated custom collapsed view at about 48 dp, so one row: the
  countdown, then the timer label. Text appearances come from the notification
  styles so the system theme (light / dark) colours them — no fixed colours.
  The Chronometer runs while the timer does; a paused timer shows the frozen
  remaining time in the static TextView instead (a stopped Chronometer
  recomputes its text from "now" whenever the shade re-inflates the view).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <Chronometer
    android:id="@+id/timer_live_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
    android:textSize="@dimen/timer_live_collapsed_count_size"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/timer_live_frozen"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
    android:textSize="@dimen/timer_live_collapsed_count_size"
    android:textStyle="bold"
    android:visibility="gone" />

  <TextView
    android:id="@+id/timer_live_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/timer_live_gap"
    android:layout_weight="1"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification" />
</LinearLayout>
