<?xml version="1.0" encoding="utf-8"?>
<!--
  Live countdown notification, expanded (SPEC.md §5.21 stage 3): a big
  countdown, then the timer label and "Ends at 14:05" / "Paused". Same
  theme-driven text appearances and running / paused split as the collapsed
  layout (timer_live_collapsed.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <Chronometer
    android:id="@+id/timer_live_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
    android:textSize="@dimen/timer_live_expanded_count_size"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/timer_live_frozen"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
    android:textSize="@dimen/timer_live_expanded_count_size"
    android:textStyle="bold"
    android:visibility="gone" />

  <TextView
    android:id="@+id/timer_live_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

  <TextView
    android:id="@+id/timer_live_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@style/TextAppearance.Compat.Notification" />
</LinearLayout>
